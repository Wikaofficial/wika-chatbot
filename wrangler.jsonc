{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wikaofficial",
  "main": "src/index.js",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
